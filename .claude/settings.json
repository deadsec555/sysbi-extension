{
  "permissions": {
    "deny": [
      "Edit(/raw/**)",
      "Write(/raw/**)",
      "Bash(rm:*raw/*)",
      "Bash(mv:*raw/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-raw.py\""
          }
        ]
      }
    ]
  }
}
